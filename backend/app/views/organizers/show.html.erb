<div class="organizer-page">
  <nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">ISTL Sports</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <%= link_to "Homepage", organizer_path, class: "nav-link active" %>
          <%= link_to "Create tournament", new_organizer_tournament_path, class: "nav-link" %>
          <%= link_to "Profile", profile_user_path, class: "nav-link" %>
        </div>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="page-narrow">
      <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div class="min-w-0">
          <h2 class="mb-1">Organizer homepage</h2>
          <div class="page-subtitle">Manage your tournaments and monitor match outcomes</div>
        </div>

        <div class="d-flex justify-content-end">
          <%= link_to new_organizer_tournament_path, class: "btn btn-primary", title: "Create a new tournament" do %>
            <span class="me-1" aria-hidden="true">＋</span> Create tournament
          <% end %>
        </div>
      </div>

      <div class="accordion" id="organizerTournamentsAccordion">
        <% if @tournaments.empty? %>
          <div class="text-body-secondary">No tournaments yet.</div>
        <% end %>

        <% @tournaments.each_with_index do |t, idx| %>
          <% heading_id = "orgT#{idx}Heading" %>
          <% collapse_id = "orgT#{idx}Collapse" %>

          <div class="accordion-item">
            <h2 class="accordion-header" id="<%= heading_id %>">
              <button class="accordion-button <%= idx == 0 ? "" : "collapsed" %>"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#<%= collapse_id %>"
                      aria-expanded="<%= idx == 0 %>"
                      aria-controls="<%= collapse_id %>">
                <div class="min-w-0">
                  <div class="d-flex align-items-center gap-2 flex-wrap">
                    <p class="tournament-title mb-0"><%= t.name %></p>
                  </div>

                  <div class="tournament-meta">
                    <span class="meta-chip">📅 <%= t.start_date&.to_date&.strftime("%d/%m/%Y") || "—" %></span>
                    <span class="sport-chip"><%= t.sport&.variant_kind&.humanize %></span>
                    <span class="meta-chip">🏟️ <%= t.court&.name || "—" %></span>
                  </div>
                </div>
              </button>
            </h2>

            <div id="<%= collapse_id %>"
                 class="accordion-collapse collapse <%= idx == 0 ? "show" : "" %>"
                 aria-labelledby="<%= heading_id %>"
                 data-bs-parent="#organizerTournamentsAccordion">
              <div class="accordion-body">
                <section class="section-block">
                  <div class="section-header">
                    <p class="section-title mb-0">Matches</p>
                  </div>

                  <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                      <thead class="table-light">
                      <tr>
                        <th scope="col">Participants</th>
                        <th scope="col">Round</th>
                        <th scope="col">Start date</th>
                        <th scope="col">Start time</th>
                        <th scope="col">Stadium</th>
                        <th scope="col">Referee</th>
                        <th scope="col" class="action-end">Winner</th>
                      </tr>
                      </thead>

                      <tbody>
                      <% if t.matches.empty? %>
                        <tr>
                          <td colspan="7" class="text-center py-4 text-body-secondary">No matches.</td>
                        </tr>
                      <% end %>

                      <% t.matches.each do |m| %>
                        <% result = @results_by_match_id[m.id] %>

                        <tr>
                          <td>
                            <% participants = @participants_by_match_id[m.id] || { left: [], right: [] } %>
                            <div class="participants">
                              <div class="team">
                                <% participants[:left].each do |label| %>
                                  <span class="player"><%= label %></span>
                                <% end %>
                              </div>
                              <div class="vs">vs</div>
                              <div class="team">
                                <% participants[:right].each do |label| %>
                                  <span class="player"><%= label %></span>
                                <% end %>
                              </div>
                            </div>
                          </td>
                          <td><span class="badge text-bg-secondary"><%= m.round ? "Round #{m.round}" : "—" %></span></td>
                          <td><%= m.date&.to_date&.strftime("%d/%m/%Y") %></td>
                          <td><%= m.date&.strftime("%H:%M") %></td>
                          <td><%= t.court&.name %></td>
                          <td>
                            <span class="ref-chip"><%= m.referee ? "#{m.referee.first_name} #{m.referee.last_name}" : "—" %></span>
                          </td>

                          <td class="action-end">
                            <% if result.present? %>
                              <span class="winner-chip">
                                <span class="winner-dot" aria-hidden="true"></span>
                                <%= @winner_by_match_id[m.id] %>
                              </span>
                            <% else %>
                              <span class="text-body-secondary">—</span>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                      </tbody>
                    </table>
                  </div>
                </section>
              </div>
            </div>
          </div>

        <% end %>
      </div>
    </div>
  </div>
</div>
