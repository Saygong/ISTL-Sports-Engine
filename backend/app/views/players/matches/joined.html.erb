<div class="booked-page player-registrations-page">
  <nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">ISTL Sports</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
              aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <%= link_to "Homepage", player_path, class: "nav-link" %>
          <%= link_to "Tournament Registrations", joined_player_matches_path, class: "nav-link active", aria: { current: "page" } %>
          <%= link_to "Booked Matches", player_matches_path, class: "nav-link" %>
          <%= link_to "Profile", profile_user_path, class: "nav-link" %>
        </div>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="page-narrow">
      <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div class="min-w-0">
          <h2 class="mb-1">Your matches</h2>
          <div class="page-subtitle">Matches you are scheduled to play</div>
        </div>
      </div>

      <section class="card shadow-sm">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
          <strong class="fs-5">Upcoming matches</strong>
          <span class="text-body-secondary small">No actions available here</span>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
              <th scope="col">Participants</th>
              <th scope="col">Tournament</th>
              <th scope="col">Round</th>
              <th scope="col">Start date</th>
              <th scope="col">Start time</th>
              <th scope="col">Stadium</th>
              <th scope="col">Organizer</th>
            </tr>
            </thead>

            <tbody>
            <% if @matches.empty? %>
              <tr>
                <td colspan="7" class="text-center py-5 text-body-secondary">No scheduled matches yet.</td>
              </tr>
            <% else %>
              <% @matches.each do |m| %>
                <tr>
                  <td>
                    <% participants = @participants_by_match_id[m.id] || { left: [], right: [] }%>
                    <div class="participants">
                      <div class="team">
                        <% if participants[:left].any? %>
                          <% participants[:left].each do |label| %>
                            <span class="player"><%= label %></span>
                          <% end %>
                        <% else %>
                          <span class="player text-body-secondary">—</span>
                        <% end %>
                      </div>
                      <div class="vs">vs</div>
                      <div class="team">
                        <% if participants[:right].any? %>
                          <% participants[:right].each do |label| %>
                            <span class="player"><%= label %></span>
                          <% end %>
                        <% else %>
                          <span class="player text-body-secondary">—</span>
                        <% end %>
                      </div>
                    </div>
                  </td>

                  <td class="tournament-cell">
                    <div class="tournament-title"><%= m.tournament.name %></div>
                    <!--<div class="tournament-sub">
                      <span class="sport-chip"><%#= m.tournament.sport.description.presence || m.tournament.sport.variant_kind.humanize %></span>
                    </div>-->
                  </td>

                  <td><span class="badge text-bg-secondary"><%= m.round.present? ? "Round #{m.round}" : "—" %></span></td>
                  <td><%= m.date&.to_date&.strftime("%d/%m/%Y") %></td>
                  <td><%= m.date&.strftime("%H:%M") %></td>
                  <td><%= m.tournament.court&.name %></td>

                  <td>
                    <span class="org-chip">
                      <%= m.tournament.organizer&.organization_name.presence ||
                            [m.tournament.organizer&.first_name, m.tournament.organizer&.last_name].compact.join(" ").presence ||
                            "—" %>
                    </span>
                  </td>
                </tr>
              <% end %>
            <% end %>
            </tbody>

          </table>
        </div>
      </section>
    </div>
  </div>
</div>