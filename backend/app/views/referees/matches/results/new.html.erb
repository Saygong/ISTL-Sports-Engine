<div class="referee-result-page">
  <nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">ISTL Sports</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
              aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <%= link_to "Homepage", referee_path, class: "nav-link" %>
          <%= link_to "Profile", profile_user_path, class: "nav-link" %>
        </div>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="page-narrow">
      <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div class="min-w-0">
          <h2 class="mb-1">Insert match result</h2>
          <div class="page-subtitle">Confirm the final score and assign the winner</div>
        </div>

        <div class="d-flex flex-wrap gap-2">
          <span class="meta-chip">Tournament: <%= @match.tournament.name %></span>
          <span class="sport-chip"><%= @match.tournament.sport.description.presence || @match.tournament.sport.variant_kind.humanize %></span>
          <span class="meta-chip"><%= @match.date&.to_date&.strftime("%d/%m/%Y") %></span>
        </div>
      </div>

      <section class="card shadow-sm">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
          <strong class="fs-5">Match details</strong>
        </div>

        <div class="card-body">
          <%= form_with url: referee_match_results_path(@match), scope: :match_result, local: true do |f| %>

            <div class="row g-3 mb-3">
              <div class="col-12 col-md-8">
                <div class="detail-item">
                  <div class="detail-label"><strong>Participants</strong></div>
                  <div class="detail-value">
                    <% participants = @participants %>
                    <div class="participants mt-1">
                      <div class="team">
                        <% participants[:left].each do |label| %>
                          <span class="player"><%= label %></span>
                        <% end %>
                      </div>
                      <div class="vs">vs</div>
                      <div class="team">
                        <% participants[:right].each do |label| %>
                          <span class="player"><%= label %></span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12 col-md-2">
                <div class="detail-item">
                  <div class="detail-label"><strong>Round</strong></div>
                  <div class="detail-value"><%= @match.round %></div>
                </div>
              </div>

              <div class="col-12 col-md-4">
                <div class="detail-item">
                  <div class="detail-label"><strong>Start date</strong></div>
                  <div class="detail-value"><%= @match.date&.to_date&.strftime("%d/%m/%Y") %></div>
                </div>
              </div>

              <div class="col-12 col-md-4">
                <div class="detail-item">
                  <div class="detail-label"><strong>Start time</strong></div>
                  <div class="detail-value"><%= @match.date&.strftime("%H:%M") %></div>
                </div>
              </div>

              <div class="col-12 col-md-4">
                <div class="detail-item">
                  <div class="detail-label"><strong>Stadium</strong></div>
                  <div class="detail-value"><%= @match.tournament.court&.name %></div>
                </div>
              </div>
            </div>

            <div class="section-block">
              <div class="section-header">
                <h3 class="section-title fs-6">Results</h3>
              </div>

              <div class="p-3 p-md-4">
                <div class="row g-3 mb-3">
                  <div class="col-12">
                    <%= f.label :description, "Description / score", class: "form-label fw-semibold" %>
                    <%= f.text_area :description,
                                    class: "form-control",
                                    rows: 3,
                                    placeholder: "Example: 6-4, 6-7, 7-5..." %>
                  </div>

                  <div class="col-12 col-md-8">
                    <label for="winner_team_id" class="form-label fw-semibold">Winner</label>
                    <select id="winner_team_id" class="form-select" name="winner_team_id" required>
                      <option value="" selected disabled>Select the winner</option>
                      <% @winner_team_options.each do |label, id| %>
                        <option value="<%= id %>"><%= label %></option>
                      <% end %>
                    </select>
                    <div class="form-text">Only participants can be selected.</div>
                  </div>
                </div>

                <div class="actions-bar">
                  <%= link_to "Cancel", referee_path, class: "btn btn-outline-secondary" %>
                  <%= f.submit "Save", class: "btn btn-primary" %>
                </div>
              </div>
            </div>

          <% end %>
        </div>
      </section>
    </div>
  </div>
</div>
