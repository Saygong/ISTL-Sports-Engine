<div class="organizer-create-page">
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">ISTL Sports</a>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNavAltMarkup"
        aria-controls="navbarNavAltMarkup"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <a class="nav-link" href="#">Homepage</a>
          <a class="nav-link active" aria-current="page" href="#">Create tournament</a>
          <a class="nav-link" href="#">Profile</a>
        </div>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="page-narrow">
      <!-- Header -->
      <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div class="min-w-0">
          <h2 class="mb-1">Create tournament</h2>
          <div class="page-subtitle">Fill the details and generate your tournament structure</div>
        </div>
      </div>

      <!-- Form card -->
      <section class="card shadow-sm">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
          <strong class="fs-5">Tournament form</strong>
        </div>

        <div class="card-body">
          <form action="#" method="post">
            <div class="d-grid gap-3">
              <!-- Core info -->
              <section class="section-block">
                <div class="section-header">
                  <p class="section-title mb-0">General info</p>
                </div>

                <div class="p-3">
                  <div class="row g-3">
                    <div class="col-12 col-md-6">
                      <label for="tName" class="form-label">Tournament name</label>
                      <input
                        id="tName"
                        name="tournament_name"
                        type="text"
                        class="form-control"
                        placeholder="e.g. Wimbledon"
                        required
                        />
                    </div>

                    <div class="col-12 col-md-6">
                      <label for="tSport" class="form-label">Sport type</label>
                      <select id="tSport" name="sport_type" class="form-select" required>
                        <option value="" selected disabled>Select sport</option>
                        <option value="Tennis">Tennis</option>
                        <option value="Table tennis">Table tennis</option>
                        <option value="Beach tennis">Beach tennis</option>
                        <option value="Badminton">Badminton</option>
                        <option value="Squash">Squash</option>
                        <option value="Padel">Padel</option>
                        <option value="Pickleball">Pickleball</option>
                      </select>
                    </div>

                    <div class="col-12 col-md-6">
                      <label for="tStart" class="form-label">Start date</label>
                      <!-- Keep type="date" for native picker; server can format as dd/mm/yyyy -->
                      <input id="tStart" name="start_date" type="date" class="form-control" required />
                    </div>

                    <div class="col-12 col-md-6">
                      <label for="tStadium" class="form-label">Stadium</label>
                      <select id="tStadium" name="stadium" class="form-select" required>
                        <option value="" selected disabled>Select stadium</option>
                        <option value="Centre Court">Centre Court</option>
                        <option value="Court 1">Court 1</option>
                        <option value="Court 2">Court 2</option>
                        <option value="Arena Hall">Arena Hall</option>
                        <option value="Seaside Court">Seaside Court</option>
                      </select>
                    </div>

                    <!-- NEW: Age restrictions -->
                    <div class="col-12 col-md-3">
                      <label for="minAge" class="form-label">Min age</label>
                      <input
                        id="minAge"
                        name="min_age"
                        type="number"
                        class="form-control"
                        min="0"
                        step="1"
                        placeholder="e.g. 16"
                        required
                        />
                    </div>

                    <div class="col-12 col-md-3">
                      <label for="maxAge" class="form-label">Max age</label>
                      <input
                        id="maxAge"
                        name="max_age"
                        type="number"
                        class="form-control"
                        min="0"
                        step="1"
                        placeholder="e.g. 45"
                        required
                        />
                    </div>

                    <!-- NEW: Gender -->
                    <div class="col-12 col-md-3">
                      <label for="tGender" class="form-label">Participants gender</label>
                      <select id="tGender" name="participants_gender" class="form-select" required>
                        <option value="" selected disabled>Select gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                      </select>
                    </div>

                    <!-- NEW: Individual vs Team based -->
                    <div class="col-12 col-md-3">
                      <label for="matchMode" class="form-label">Match mode</label>
                      <select id="matchMode" name="match_mode" class="form-select" required>
                        <option value="" selected disabled>Select mode</option>
                        <option value="Individual">Individual (1v1)</option>
                        <option value="Team">Team-based (2v2)</option>
                      </select>
                    </div>

                    <div class="col-12">
                      <div class="form-text">
                        Note: validate that <strong>min age</strong> ≤ <strong>max age</strong> on the backend.
                      </div>
                    </div>
                  </div>
                </div>
              </section>

              <!-- Referees -->
              <section class="section-block">
                <div class="section-header">
                  <p class="section-title mb-0">Referees</p>
                  <span class="text-body-secondary small">Select up to 3</span>
                </div>

                <div class="p-3">
                  <div class="row g-3">
                    <div class="col-12 col-md-4">
                      <label for="ref1" class="form-label">Referee #1</label>
                      <select id="ref1" name="referee_1" class="form-select">
                        <option value="" selected>None</option>
                        <option value="Alice Verdi">Alice Verdi</option>
                        <option value="Marco Bianchi">Marco Bianchi</option>
                        <option value="Sara Ferri">Sara Ferri</option>
                        <option value="Luca Neri">Luca Neri</option>
                        <option value="Elena Costa">Elena Costa</option>
                        <option value="Paolo Russo">Paolo Russo</option>
                        <option value="Giulia Romano">Giulia Romano</option>
                      </select>
                    </div>

                    <div class="col-12 col-md-4">
                      <label for="ref2" class="form-label">Referee #2</label>
                      <select id="ref2" name="referee_2" class="form-select">
                        <option value="" selected>None</option>
                        <option value="Alice Verdi">Alice Verdi</option>
                        <option value="Marco Bianchi">Marco Bianchi</option>
                        <option value="Sara Ferri">Sara Ferri</option>
                        <option value="Luca Neri">Luca Neri</option>
                        <option value="Elena Costa">Elena Costa</option>
                        <option value="Paolo Russo">Paolo Russo</option>
                        <option value="Giulia Romano">Giulia Romano</option>
                      </select>
                    </div>

                    <div class="col-12 col-md-4">
                      <label for="ref3" class="form-label">Referee #3</label>
                      <select id="ref3" name="referee_3" class="form-select">
                        <option value="" selected>None</option>
                        <option value="Alice Verdi">Alice Verdi</option>
                        <option value="Marco Bianchi">Marco Bianchi</option>
                        <option value="Sara Ferri">Sara Ferri</option>
                        <option value="Luca Neri">Luca Neri</option>
                        <option value="Elena Costa">Elena Costa</option>
                        <option value="Paolo Russo">Paolo Russo</option>
                        <option value="Giulia Romano">Giulia Romano</option>
                      </select>
                    </div>

                    <div class="col-12">
                      <div class="form-text">
                        Tip: prevent duplicates with backend validation (or JS if you later allow it).
                      </div>
                    </div>
                  </div>
                </div>
              </section>

              <!-- Matches config -->
              <section class="section-block">
                <div class="section-header">
                  <p class="section-title mb-0">Match configuration</p>
                </div>

                <div class="p-3">
                  <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-6">
                      <label for="matchCount" class="form-label">Number of matches</label>
                      <select id="matchCount" name="match_count" class="form-select" required>
                        <option value="" selected disabled>Select amount</option>
                        <option value="2">2</option>
                        <option value="4">4</option>
                        <option value="8">8</option>
                        <option value="16">16</option>
                      </select>
                      <div class="form-text">
                        Example: 8 matches = 16 participants (individual) or 32 partecipants (16 teams).
                      </div>
                    </div>
                  </div>
                </div>
              </section>

              <!-- Actions -->
              <div class="actions-bar">
                <a href="#" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save</button>
              </div>
            </div>
          </form>
        </div>
      </section>
    </div>
  </div>
</div>