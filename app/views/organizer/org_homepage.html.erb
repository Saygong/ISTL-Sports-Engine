                      <td>12/01/2026</td>
                      <td>11:15</td>
                      <td>Court 1</td>
                      <td><span class="ref-chip">Marco Bianchi</span></td>
                      <td class="action-end">
                        <span class="badge text-bg-light text-body-secondary">Not set</span>
