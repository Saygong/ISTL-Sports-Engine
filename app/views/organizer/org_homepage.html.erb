            <div class="accordion-body">
              <section class="section-block">
                <div class="section-header">
                  <p class="section-title mb-0">Matches</p>
                </div>

                <div class="table-responsive">
                  <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                      <th scope="col">Participants</th>
                      <th scope="col">Round</th>
                      <th scope="col">Start date</th>
                      <th scope="col">Start time</th>
                      <th scope="col">Stadium</th>
                      <th scope="col">Referee</th>
                      <th scope="col" class="action-end">Winner</th>
                    </tr>
                    </thead>

                    <tbody>
                    <!-- Finished -->
                    <tr>
                      <td>
                        <div class="participants">
                          <div class="team"><span class="player">J. Sinner</span></div>
                          <div class="vs">vs</div>
                          <div class="team"><span class="player">C. Alcaraz</span></div>
                        </div>
                      </td>
                      <td><span class="badge text-bg-secondary">Round 1</span></td>
                      <td>10/01/2026</td>
                      <td>14:30</td>
                      <td>Centre Court</td>
                      <td><span class="ref-chip">Alice Verdi</span></td>
                      <td class="action-end">
                              <span class="winner-chip">
                                <span class="winner-dot" aria-hidden="true"></span>
                                J. Sinner
                              </span>
                      </td>
                    </tr>

                    <!-- Pending -->
                    <tr>
                      <td>
                        <div class="participants">
                          <div class="team"><span class="player">D. Medvedev</span></div>
