<div class="player-registrations-page booked-page">
  <nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">ISTL Sports</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <%= link_to "Homepage", player_home_path, class: "nav-link" %>
          <%= link_to "Tournament Registrations", player_registrations_path, class: "nav-link active", aria: { current: "page" } %>
          <%= link_to "Spectate", spectator_tournaments_path, class: "nav-link" %>
          <%= link_to "Booked Matches", spectator_booked_matches_path, class: "nav-link" %>
          <%= link_to "Profile", profile_path, class: "nav-link" %>
        </div>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="page-narrow">
      <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div class="min-w-0">
          <h2 class="mb-1">Your registrations</h2>
          <div class="page-subtitle">Tournaments you registered to (you can un-register here)</div>
        </div>
      </div>

      <section class="card shadow-sm">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
          <strong class="fs-5">Registered tournaments</strong>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
              <th scope="col">Tournament</th>
              <th scope="col">Start date</th>
              <th scope="col">Stadium</th>
              <th scope="col">Organizer</th>
              <th scope="col" class="text-end">Action</th>
            </tr>
            </thead>

            <tbody>
            <% if @registrations.empty? %>
              <tr>
                <td colspan="5" class="text-center py-5 text-body-secondary">
                  No registrations yet.
                </td>
              </tr>
            <% else %>
              <% @registrations.each do |t| %>
                <tr>
                  <td class="tournament-cell">
                    <div class="tournament-title"><%= t.name %></div>
                    <div class="tournament-sub">
                      <span class="sport-chip"><%= t.sport.description.presence || t.sport.variant_kind.humanize %></span>
                    </div>
                  </td>

                  <td><%= t.start_date&.to_date&.strftime("%d/%m/%Y") %></td>
                  <td><%= t.field&.name %></td>
                  <td>
                      <span class="org-chip">
                        <%= t.organizer&.organization_name.presence || [t.organizer&.first_name, t.organizer&.last_name].compact.join(" ").presence || "—" %>
                      </span>
                  </td>

                  <td class="text-end">
                      <span class="action-stack">
                        <%= button_to "Unregister",
                                      player_registration_path(t),
                                      method: :delete,
                                      class: "btn btn-sm btn-outline-danger",
                                      form: { data: { turbo_confirm: "Unregister from #{t.name}?" } } %>
                      </span>
                  </td>
                </tr>
              <% end %>
            <% end %>
            </tbody>

          </table>
        </div>
      </section>
    </div>
  </div>
</div>
