<div class="organizer-create-page">
  <nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">ISTL Sports</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <%= link_to "Homepage", organizer_home_path, class: "nav-link" %>
          <%= link_to "Create tournament", new_organizer_tournament_path, class: "nav-link active", aria: { current: "page" } %>
          <%= link_to "Profile", profile_path, class: "nav-link" %>
        </div>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="page-narrow">
      <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div class="min-w-0">
          <h2 class="mb-1">Create tournament</h2>
          <div class="page-subtitle">Fill the details and generate your tournament structure</div>
        </div>
      </div>

      <section class="card shadow-sm">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
          <strong class="fs-5">Tournament form</strong>
        </div>

        <div class="card-body">
          <%= form_with model: @tournament, url: organizer_tournaments_path, local: true do |f| %>
            <div class="d-grid gap-3">

              <section class="section-block">
                <div class="section-header">
                  <p class="section-title mb-0">General info</p>
                </div>

                <div class="p-3">
                  <div class="row g-3">
                    <div class="col-12 col-md-6">
                      <%= f.label :name, class: "form-label fw-semibold" %>
                      <%= f.text_field :name, class: "form-control", placeholder: "e.g. Wimbledon" %>
                    </div>

                    <div class="col-12 col-md-6">
                      <%= f.label :sport_id, "Sport", class: "form-label fw-semibold" %>
                      <%= f.collection_select :sport_id, @sports, :id, :description, { include_blank: "Select sport" }, { class: "form-select" } %>
                    </div>

                    <div class="col-12">
                      <%= f.label :description, class: "form-label fw-semibold" %>
                      <%= f.text_area :description, class: "form-control", rows: 3, placeholder: "Result description..." %>
                    </div>

                    <div class="col-12 col-md-6">
                      <%= f.label :start_date, class: "form-label fw-semibold" %>
                      <%= f.datetime_local_field :start_date, class: "form-control" %>
                    </div>

                    <div class="col-12 col-md-6">
                      <%= f.label :end_date, class: "form-label fw-semibold" %>
                      <%= f.datetime_local_field :end_date, class: "form-control" %>
                    </div>

                    <div class="col-12 col-md-6">
                      <%= f.label :field_id, "Field (stadium)", class: "form-label fw-semibold" %>
                      <%= f.collection_select :field_id, @fields, :id, :name, { include_blank: "Select field" }, { class: "form-select" } %>
                    </div>
                  </div>
                </div>
              </section>

              <div class="actions-bar">
                <%= link_to "Cancel", organizer_home_path, class: "btn btn-outline-secondary" %>
                <%= f.submit "Create", class: "btn btn-primary" %>
              </div>

            </div>
          <% end %>
        </div>
      </section>

    </div>
  </div>
</div>
