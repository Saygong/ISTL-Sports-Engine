<div class="player-tournament-detail">
  <nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">ISTL Sports</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
              aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <%= link_to "Homepage", player_path, class: "nav-link" %>
          <%= link_to "Tournament Registrations", player_registrations_path, class: "nav-link" %>
          <%= link_to "Booked Matches", player_matches_path, class: "nav-link" %>
          <%= link_to "Profile", profile_user_path, class: "nav-link" %>
        </div>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="page-narrow mx-auto">
      <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div class="min-w-0">
          <h2 class="mb-1">Tournament details</h2>
          <div class="text-body-secondary">View informations for a specific tournament</div>
        </div>

        <div class="header-actions">
          <span class="elig-chip" title="Eligibility status">
            <span class="elig-dot <%= @eligible ? "elig-dot--ok" : "elig-dot--no" %>" aria-hidden="true"></span>
            <%= @eligible ? "Eligible" : "Not eligible" %>
          </span>

          <% if @is_individual %>
            <% if @is_registered %>
              <span class="btn btn-outline-secondary disabled" aria-disabled="true">Already registered</span>
            <% else %>
              <%= button_to join_player_tournament_path(@tournament),
                            method: :post,
                            class: "btn btn-primary",
                            disabled: !@eligible,
                            form: { data: { turbo_confirm: (@eligible ? "Register to #{@tournament.name}?" : nil) } } do %>
                <span class="me-1" aria-hidden="true">✍️</span> Register
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>

      <section class="card shadow-sm mb-4">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between gap-2">
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <strong class="fs-5"><%= @tournament.name %></strong>
            <span class="sport-chip"><%= @tournament.sport.description.presence || @tournament.sport.variant_kind.humanize %></span>
          </div>
        </div>

        <div class="card-body">
          <div class="row g-3">
            <div class="col-12 col-md-6 col-lg-4">
              <div class="detail-item">
                <div class="detail-label">Name</div>
                <div class="detail-value"><%= @tournament.name %></div>
              </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
              <div class="detail-item">
                <div class="detail-label">Sport</div>
                <div class="detail-value"><%= @tournament.sport.variant_kind.humanize %></div>
              </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
              <div class="detail-item">
                <div class="detail-label">Start date</div>
                <div class="detail-value"><%= @tournament.start_date&.to_date&.strftime("%d/%m/%Y") %></div>
              </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
              <div class="detail-item">
                <div class="detail-label">Stadium</div>
                <div class="detail-value"><%= @tournament.court&.name %></div>
              </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
              <div class="detail-item">
                <div class="detail-label">Organizer</div>
                <div class="detail-value">
                  <%= @tournament.organizer&.organization_name.presence || "—" %>
                </div>
              </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
              <div class="detail-item">
                <div class="detail-label">Gender of players</div>
                <div class="detail-value"><%= @tournament.gender.humanize %></div>
              </div>
            </div>

            <div class="col-12 col-md-6 col-lg-4">
              <div class="detail-item">
                <div class="detail-label">Match type</div>
                <div class="detail-value"><%= @tournament.single? ? "Individual" : "Team (double)" %></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Matches card -->
      <section class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
          <strong class="fs-5">Matches</strong>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
              <th scope="col">Participants</th>
              <th scope="col">Round</th>
              <th scope="col">Start date</th>
              <th scope="col">Start time</th>
              <th scope="col">Stadium</th>
              <th scope="col">Seats</th>
              <th scope="col" class="text-end">Action</th>
            </tr>
            </thead>

            <tbody>
            <% if @matches.empty? %>
              <tr>
                <td colspan="6" class="text-center py-5 text-body-secondary">No matches yet.</td>
              </tr>
            <% else %>
              <% @matches.each do |m| %>
                <% max_seats = m.tournament.field&.max_seats.to_i %>
                <% used = m.viewers.size %>
                <% available = [max_seats - used, 0].max %>
                <% reserved = @booked_match_ids.include?(m.id) %>

                <tr>
                  <td>
                    <div class="participants">
                      <% participants = @participants_by_match_id[m.id] %>
                      <div class="team">
                        <% participants[:left].each do |label| %>
                          <span class="player"><%= label %></span>
                        <% end %>
                      </div>
                      <div class="vs">vs</div>
                      <div class="team">
                        <% participants[:right].each do |label| %>
                          <span class="player"><%= label %></span>
                        <% end %>
                      </div>
                    </div>
                  </td>

                  <td><span class="badge text-bg-secondary"><%= m_round_label = (@round_by_match_id && @round_by_match_id[m.id]) || "Round -" %></span></td>
                  <td><%= m.date&.to_date&.strftime("%d/%m/%Y") %></td>
                  <td><%= m.date&.strftime("%H:%M") %></td>
                  <td><%= m.tournament.court&.name %></td>

                  <td>
                    <span class="seat-pill <%= available <= 20 ? "seat-pill--low" : "" %>">
                      <span class="seat-dot" aria-hidden="true"></span>
                      <%= available %> available
                    </span>
                  </td>

                  <td class="text-end">
                    <% if reserved %>
                      <span class="badge text-bg-success me-2">Reserved</span>
                    <% else %>
                      <%= button_to "Book",
                                    book_player_match_path(m),
                                    method: :post,
                                    class: "btn btn-sm btn-outline-primary" do %>
                        <span class="me-1" aria-hidden="true">🎟️</span> Book
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% end %>
            </tbody>

          </table>
        </div>
      </section>

      <% unless @is_individual %>
        <!-- TODO: requires a Team model to work -->
        <section class="card shadow-sm">
          <div class="card-header">
            <strong class="fs-5">Teams</strong>
            <span class="text-body-secondary small">Team joining requires team slots in DB</span>
          </div>
          <div class="card-body text-body-secondary">
            This tournament is doubles. To show “teams with 0–1 players and join button”, you need a Team-like model.
          </div>
        </section>
      <% end %>



    </div>
  </div>
</div>
