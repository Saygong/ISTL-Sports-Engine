<div class="booked-page">
  <nav class="navbar navbar-expand-lg bg-body-tertiary">
    <div class="container-fluid">
      <a class="navbar-brand" href="#">ISTL Sports</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup"
              aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <%= link_to "Homepage", player_path, class: "nav-link" %>
          <%= link_to "Booked Matches", player_matches_path, class: "nav-link" %>
          <%= link_to "Profile", profile_user_path, class: "nav-link" %>
        </div>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <div class="page-narrow">
      <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div class="min-w-0">
          <h2 class="mb-1">Booked matches</h2>
          <div class="page-subtitle">These are the matches you reserved tickets for</div>
        </div>
      </div>

      <section class="card shadow-sm">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
          <strong class="fs-5">Your reservations</strong>
          <span class="text-body-secondary small">Only unbooking is available here</span>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
              <th scope="col">Participants</th>
              <th scope="col">Tournament</th>
              <th scope="col">Round</th>
              <th scope="col">Start date</th>
              <th scope="col">Start time</th>
              <th scope="col">Stadium</th>
              <th scope="col">Seats</th>
              <th scope="col" class="text-end">Action</th>
            </tr>
            </thead>

            <tbody>
            <% if @matches.empty? %>
              <tr>
                <td colspan="7" class="text-center py-5 text-body-secondary">No booked matches yet.</td>
              </tr>
            <% else %>
              <% @matches.each do |m| %>
                <% max_seats = m.tournament.field&.max_seats.to_i %>
                <% used = m.viewers.size %>
                <% available = [max_seats - used, 0].max %>

                <tr>
                  <td>
                    <div class="participants">
                      <div class="team">
                        <% m.players.first(1).each do |p| %>
                          <span class="player"><%= [p.first_name, p.last_name].compact.join(" ").presence || p.email %></span>
                        <% end %>
                      </div>
                      <div class="vs">vs</div>
                      <div class="team">
                        <% m.players.drop(1).first(1).each do |p| %>
                          <span class="player"><%= [p.first_name, p.last_name].compact.join(" ").presence || p.email %></span>
                        <% end %>
                      </div>
                    </div>
                  </td>

                  <td class="tournament-cell">
                    <div class="tournament-title"><%= m.tournament.name %></div>
                    <div class="tournament-sub">
                      <span class="sport-chip"><%= m.tournament.sport.description.presence || m.tournament.sport.variant_kind.humanize %></span>
                    </div>
                  </td>

                  <td><span class="badge text-bg-secondary"><%= m.round %></span></td>
                  <td><%= m.date&.to_date&.strftime("%d/%m/%Y") %></td>
                  <td><%= m.date&.strftime("%H:%M") %></td>
                  <td><%= m.tournament.field&.name %></td>

                  <td>
                      <span class="seat-pill <%= available <= 20 ? "seat-pill--low" : "" %>">
                        <span class="seat-dot" aria-hidden="true"></span>
                        <%= available %> available
                      </span>
                  </td>

                  <td class="text-end">
                      <span class="action-stack">
                        <%= button_to "Unbook",
                                      spectator_booked_match_path(m),
                                      method: :delete,
                                      class: "btn btn-sm btn-outline-danger",
                                      form: { data: { turbo_confirm: "Unbook this match?" } } %>
                      </span>
                  </td>
                </tr>
              <% end %>
            <% end %>
            </tbody>

          </table>
        </div>
      </section>
    </div>
  </div>
</div>
