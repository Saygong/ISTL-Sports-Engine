<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Tournaments</h2>
  </div>

  <!-- Filters -->
  <div class="card mb-3">
    <div class="card-body">
      <div class="row g-3 align-items-end">
        <div class="col-12 col-md-4">
          <label for="filterName" class="form-label">Name</label>
          <input
            id="filterName"
            type="text"
            class="form-control"
            placeholder="e.g. Wimbledon"
            />
        </div>

        <div class="col-12 col-md-4">
          <label for="filterSport" class="form-label">Sport</label>
          <select id="filterSport" class="form-select">
            <option value="">All</option>
            <option value="Tennis">Tennis</option>
            <option value="Table tennis">Table tennis</option>
            <option value="Beach tennis">Beach tennis</option>
            <option value="Badminton">Badminton</option>
            <option value="Squash">Squash</option>
            <option value="Padel">Padel</option>
            <option value="Pickleball">Pickleball</option>
          </select>
        </div>

        <div class="col-12 col-md-4">
          <label for="filterStartDate" class="form-label"
          >Start date</label
          >
          <input
            id="filterStartDate"
            type="text"
            class="form-control"
            placeholder="dd/mm/yyyy"
            inputmode="numeric"
            />
        </div>

        <div class="col-12 d-flex gap-2">
          <button id="btnSearch" class="btn btn-primary">
            <span class="me-1" data-feather="search"></span> Search
          </button>
          <button id="btnReset" class="btn btn-outline-secondary">
            <span class="me-1" data-feather="rotate-ccw"></span> Reset
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Table -->
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Sport</th>
        <th scope="col">Start date</th>
        <th scope="col">Action</th>
      </tr>
      </thead>
      <tbody id="tournamentsTbody">
      <tr>
        <th scope="row">Winbledon</th>
        <td>Tennis</td>
        <td>10/01/2026</td>
        <td><span class="me-1" data-feather="external-link"></span> Details</td>
      </tr>
      <tr>
        <th scope="row">AP-2000</th>
        <td>Table tennis</td>
        <td>14/04/2026</td>
        <td><span class="me-1" data-feather="external-link"></span> Details</td>
      </tr>
      <tr>
        <th scope="row">Summer fest</th>
        <td>Beach tennis</td>
        <td>20/05/2026</td>
        <td><span class="me-1" data-feather="external-link"></span> Details</td>
      </tr>
      </tbody>
    </table>
  </div>
</div>