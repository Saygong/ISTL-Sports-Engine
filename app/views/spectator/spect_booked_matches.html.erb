              <td><span class="badge text-bg-secondary">Round 1</span></td>
              <td>10/01/2026</td>
              <td>14:30</td>
              <td>Centre Court</td>
              <td>
                      <span class="seat-pill">
                        <span class="seat-dot" aria-hidden="true"></span>
                        210 available
                      </span>
              </td>
              <td class="text-end">
                      <span class="action-stack">
                        <a class="btn btn-sm btn-outline-danger" href="#" title="Unbook ticket">
                          <span class="me-1" aria-hidden="true">✖</span> Unbook
                        </a>
                      </span>
              </td>
            </tr>

            <!-- Booked 2v2 -->
            <tr>
              <td>
                <div class="participants">
                  <div class="team">
                    <span class="player">M. Rossi</span>
                    <span class="player">L. Bianchi</span>
                  </div>
                  <div class="vs">vs</div>
                  <div class="team">
                    <span class="player">S. Neri</span>
                    <span class="player">G. Conti</span>
                  </div>
                </div>
              </td>

              <td class="tournament-cell">
                <div class="tournament-title">AP-2000</div>
                <div class="tournament-sub">
                  <span class="sport-chip">Table tennis</span>
                </div>
              </td>

              <td><span class="badge text-bg-secondary">Round 1</span></td>
              <td>14/04/2026</td>
              <td>16:00</td>
              <td>Court 2</td>
              <td>
                      <span class="seat-pill">
                        <span class="seat-dot" aria-hidden="true"></span>
                        85 available
                      </span>
              </td>
              <td class="text-end">
                      <span class="action-stack">
                        <a class="btn btn-sm btn-outline-danger" href="#" title="Unbook ticket">
                          <span class="me-1" aria-hidden="true">✖</span> Unbook
                        </a>
                      </span>
              </td>
            </tr>

            <!-- Booked (low seats visual) -->
            <tr>
              <td>
                <div class="participants">
                  <div class="team"><span class="player">A. Verdi</span></div>
