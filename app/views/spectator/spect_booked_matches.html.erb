            </thead>

            <tbody>
            <!-- Booked 1v1 -->
            <tr>
              <td>
                <div class="participants">
                  <div class="team"><span class="player">J. Sinner</span></div>
                  <div class="vs">vs</div>
                  <div class="team"><span class="player">C. Alcaraz</span></div>
                </div>
              </td>

              <td class="tournament-cell">
                <div class="tournament-title">Wimbledon</div>
                <div class="tournament-sub">
                  <span class="sport-chip">Tennis</span>
                </div>
