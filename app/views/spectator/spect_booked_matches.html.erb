              <th scope="col">Tournament</th>
              <th scope="col">Round</th>
              <th scope="col">Start date</th>
              <th scope="col">Start time</th>
              <th scope="col">Stadium</th>
              <th scope="col">Seats</th>
              <th scope="col" class="text-end">Action</th>
