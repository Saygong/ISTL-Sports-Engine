              <td class="tournament-cell">
                <div class="tournament-title">Summer fest</div>
                <div class="tournament-sub">
                  <span class="sport-chip">Beach tennis</span>
                </div>
              </td>

              <td><span class="badge text-bg-warning">Round 2</span></td>
              <td>20/05/2026</td>
              <td>11:15</td>
              <td>Court 1</td>
              <td>
                      <span class="seat-pill seat-pill--low">
                        <span class="seat-dot" aria-hidden="true"></span>
                        12 available
                      </span>
              </td>
              <td class="text-end">
                      <span class="action-stack">
                        <a class="btn btn-sm btn-outline-danger" href="#" title="Unbook ticket">
                          <span class="me-1" aria-hidden="true">✖</span> Unbook
                        </a>
                      </span>
              </td>
            </tr>

            <!-- Empty state example (remove if you don't need it) -->
