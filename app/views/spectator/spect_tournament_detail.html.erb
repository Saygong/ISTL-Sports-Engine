<nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">ISTL Sports</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <%= link_to "Homepage", player_home_path, class: "nav-link" %>
        <%= link_to "Tournament Registrations", player_registrations_path, class: "nav-link" %>
        <%= link_to "Spectate", spectator_tournaments_path, class: "nav-link active", aria: { current: "page" } %>
        <%= link_to "Booked Matches", spectator_booked_matches_path, class: "nav-link" %>
        <%= link_to "Profile", profile_path, class: "nav-link" %>
      </div>
    </div>
  </div>
</nav>

<div class="container py-4">
  <div class="page-narrow mx-auto">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <div>
        <h2 class="mb-1">Tournament details</h2>
        <div class="text-body-secondary">View info and matches for a specific tournament</div>
      </div>
    </div>

    <section class="card shadow-sm mb-4">
      <div class="card-header d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2">
          <span class="badge text-bg-primary">Active</span>
          <strong class="fs-5"><%= @tournament.name %></strong>
        </div>
      </div>

      <div class="card-body">
        <div class="row g-3">
          <div class="col-12 col-md-6 col-lg-4">
            <div class="detail-item">
              <div class="detail-label">Name</div>
              <div class="detail-value"><%= @tournament.name %></div>
            </div>
          </div>

          <div class="col-12 col-md-6 col-lg-4">
            <div class="detail-item">
              <div class="detail-label">Sport</div>
              <div class="detail-value"><%= @tournament.sport.description.presence || @tournament.sport.variant_kind.humanize %></div>
            </div>
          </div>

          <div class="col-12 col-md-6 col-lg-4">
            <div class="detail-item">
              <div class="detail-label">Start date</div>
              <div class="detail-value"><%= @tournament.start_date&.to_date&.strftime("%d/%m/%Y") %></div>
            </div>
          </div>

          <div class="col-12 col-md-6 col-lg-4">
            <div class="detail-item">
              <div class="detail-label">Number of rounds</div>
              <div class="detail-value"><%= @number_of_rounds %></div>
            </div>
          </div>

          <div class="col-12 col-md-6 col-lg-4">
            <div class="detail-item">
              <div class="detail-label">Participants</div>
              <div class="detail-value"><%= @participants_count %></div>
            </div>
          </div>

          <div class="col-12 col-md-6 col-lg-4">
            <div class="detail-item">
              <div class="detail-label">Referee</div>
              <div class="detail-value"><%= @head_referee_name %></div>
            </div>
          </div>

          <div class="col-12 col-md-6 col-lg-4">
            <div class="detail-item">
              <div class="detail-label">Organizer</div>
              <div class="detail-value"><%= @organizer_name %></div>
            </div>
          </div>

          <div class="col-12 col-md-6 col-lg-4">
            <div class="detail-item">
              <div class="detail-label">Gender of players</div>
              <div class="detail-value"><%= @participants_gender %></div>
            </div>
          </div>

          <div class="col-6 col-md-3 col-lg-2">
            <div class="detail-item">
              <div class="detail-label">Min age</div>
              <div class="detail-value"><%= @min_age %></div>
            </div>
          </div>

          <div class="col-6 col-md-3 col-lg-2">
            <div class="detail-item">
              <div class="detail-label">Max age</div>
              <div class="detail-value"><%= @max_age %></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Matches card -->
    <section class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <strong class="fs-5">Matches</strong>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
          <tr>
            <th scope="col">Participants</th>
            <th scope="col">Round</th>
            <th scope="col">Start date</th>
            <th scope="col">Start time</th>
            <th scope="col">Stadium</th>
            <th scope="col">Seats</th>
            <th scope="col" class="text-end">Action</th>
          </tr>
          </thead>

          <tbody>
          <% if @matches.empty? %>
            <tr>
              <td colspan="6" class="text-center py-5 text-body-secondary">No matches yet.</td>
            </tr>
          <% else %>
            <% @matches.each do |m| %>
              <% max_seats = m.field&.max_seats.to_i %>
              <% used = m.viewers.size %>
              <% available = [max_seats - used, 0].max %>
              <% reserved = @booked_match_ids.include?(m.id) %>

              <tr>
                <td>
                  <div class="participants">
                    <div class="team">
                      <% m.players.first(1).each do |p| %>
                        <span class="player"><%= [p.first_name, p.last_name].compact.join(" ").presence || p.email %></span>
                      <% end %>
                    </div>
                    <div class="vs">vs</div>
                    <div class="team">
                      <% m.players.drop(1).first(1).each do |p| %>
                        <span class="player"><%= [p.first_name, p.last_name].compact.join(" ").presence || p.email %></span>
                      <% end %>
                    </div>
                  </div>
                </td>

                <td><span class="badge text-bg-secondary"><%= m_round_label = (@round_by_match_id && @round_by_match_id[m.id]) || "Round -" %></span></td>
                <td><%= m.date&.to_date&.strftime("%d/%m/%Y") %></td>
                <td><%= m.date&.strftime("%H:%M") %></td>
                <td><%= m.tournament.field&.name %></td>

                <td>
                    <span class="seat-pill <%= available <= 20 ? "seat-pill--low" : "" %>">
                      <span class="seat-dot" aria-hidden="true"></span>
                      <%= available %> available
                    </span>
                </td>

                <td class="text-end">
                  <% if reserved %>
                    <span class="badge text-bg-success me-2">Reserved</span>
                  <% else %>
                    <%= button_to "Book",
                                  spectator_book_match_path(m),
                                  method: :post,
                                  class: "btn btn-sm btn-outline-primary" do %>
                      <span class="me-1" aria-hidden="true">🎟️</span> Book
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
          </tbody>

        </table>
      </div>
    </section>
  </div>
</div>
